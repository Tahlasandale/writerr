{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writer Deck",
  "version": "0.1.0",
  "identifier": "app.writerdeck.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Writer Deck",
        "width": 1000,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Écriture concentrée, sans distraction",
    "longDescription": "Éditeur Markdown à la WYSIWYG dont les documents sont des fichiers .md dans un dossier de votre choix."
  }
}